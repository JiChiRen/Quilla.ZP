# quilla/ and appliance/ are independent clones of their upstream projects.
# They are deliberately NOT tracked here: keep both pullable/mergeable at any
# time. See README.md for the clone commands.
/quilla/
/appliance/

# Third-party Zephyr modules fetched for the native build. They are
# independent clones (hal_gigadevice, cmsis_6) pinned by appliance/west.yml.
/modules/


/app/build*/
/app/cmake.log
/app/build.log
/build/
**/build/zephyr/
*.elf
*.bin
*.hex
*.map
*.o
*.d
*.lst
CMakeCache.txt
CMakeFiles/

# Python
__pycache__/
*.pyc

# Local build state (never publish)
/.west/
/.venv/
